# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (el ejemplo seguro sí se versiona)
.env*
!.env.example

# cloudflare local secrets (wrangler / opennext dev) — nunca versionar
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated content (velite)
.velite

# cloudflare / opennext
.open-next/
.wrangler/
cloudflare-env.d.ts

# terraform local state (la configuración IaC sí se versiona)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log

# claude code: settings.json y hooks SÍ se versionan (config del proyecto);
# settings.local.json es por máquina y no debe viajar entre equipos.
.claude/settings.local.json

# playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright-cli/
/output/playwright/
.gstack/

# artefactos locales y comparativas temporales
/output/
/mesa-shots/
/.tmp-*.png
/*-tmp.mjs
/tmp-*.mjs
/_rev_measure.mjs

# capturas de tools/ (ver tools/README.md)
/.shots/

# copias locales de trabajo (backups recuperables, no viajan al repo)
/output/archive/

# codebase-memory-mcp: el índice es por máquina (~/.cache/codebase-memory-mcp).
# La opción de artefacto versionado quedó obsoleta y con conflictos (2026-09-22).
/.codebase-memory/
