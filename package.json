{
  "name": "jonas-orbit-v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content": "velite",
    "predev": "velite",
    "dev": "next dev",
    "prebuild": "velite",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "velite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "knip": "knip",
    "pretest": "velite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test && npm run build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "velite": "0.4.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
