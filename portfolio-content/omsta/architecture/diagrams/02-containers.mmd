%% OMSTA — Diagrama de contenedores (C4 nivel 2)
%% Render: npx -y @mermaid-js/mermaid-cli -i 02-containers.mmd -o 02-containers.svg
flowchart TB
    Browser["Navegador<br/>Django Templates + Bootstrap + JS"]

    subgraph Railway["Railway"]
      Web["Proceso web<br/>Gunicorn (gthread) -> Django/DRF<br/>WhiteNoise sirve estaticos"]
      Worker["Worker<br/>manage.py qcluster (Django Q2)"]
      PG[("PostgreSQL")]
      RD[("Redis<br/>DB0 colas / DB1 cache-sesion")]
    end
    S3[("S3-compatible<br/>media/documentos/exports")]
    SMTP["SMTP"]

    Browser -- HTTPS --> Web
    Web -- ORM --> PG
    Web -- cache/sesion --> RD
    Web -- encola jobs --> RD
    Worker -- consume jobs --> RD
    Worker -- ORM --> PG
    Web -- lee/escribe --> S3
    Worker -- lee/escribe --> S3
    Web -- correo --> SMTP
    Worker -- correo --> SMTP
