# Entorno local seguro. Copia este archivo como `.env.local`.

# Evita Miniflare/workerd en equipos Windows donde VBS/HVCI lo bloquea.
CF_DEV_CONTEXT=off

# Origen usado por canonical, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# El modo development usa las claves oficiales de prueba de Turnstile y no
# entrega correo real. No pongas credenciales reales en este archivo.
CONTACT_RUNTIME_ENV=development
CONTACT_DELIVERY_MODE=test
TURNSTILE_EXPECTED_HOSTNAME=localhost

# Producción: configura estos valores como secrets/vars del entorno, nunca aquí.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=
# CONTACT_TO_EMAIL=
